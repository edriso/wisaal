{
  "name": "wisaal",
  "version": "1.0.0",
  "private": true,
  "license": "0BSD",
  "description": "Wisaal: a Telegram bot for صلة الرحم — it gently nudges you, on your chosen rhythm, to reach out to one relative at a time, rotating fairly through your circle.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,yml,yaml}\"",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.46.0",
    "mariadb": "^3.5.4",
    "node-cron": "^4.6.0",
    "telegram-bot-kit": "github:edriso/telegram-bot-kit#v0.1.2",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@types/node-cron": "^3.0.11",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "mariadb@>=3.4.0 <3.4.6": ">=3.4.6",
      "mysql2@<3.22.0": ">=3.22.0",
      "mysql2@<=3.23.0": ">=3.23.1"
    }
  }
}
